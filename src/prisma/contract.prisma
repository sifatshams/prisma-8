// use prisma-8

model User {
  id      String    @id     @default(uuid())
  name    String
  email   String    @unique
  username String?
  createdAt   TimestamptzString  @default(now())
  posts   Post[]
}

model Post {
  id      String    @id     @default(uuid())
  title   String
  content String
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])
}
